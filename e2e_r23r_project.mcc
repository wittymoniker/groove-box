  "instrument_scripts": {
    "Acoustic Plate Simulation": "# Random full-graph Instrument Script \u00b7 Acoustic Plate Simulation\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    uvw = (graph_u - graph_v + graph_w) * 5.3628\n    wave = isn(uvw + graph_phase) * 0.3918 + ics(t * 1.3298) * 0.6082\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1896*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Additive Formant Synth": "# Random full-graph Instrument Script \u00b7 Additive Formant Synth\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.2948*graph_z) * MEUM * 3.0546) * cos((y - 0.2948*graph_x) * PHI * 2.7756)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.6647 + 0.3353 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2948*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Analog Drift Oscillator": "# Random full-graph Instrument Script \u00b7 Analog Drift Oscillator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.3352*graph_z) * MEUM * 4.8286) * cos((y - 0.3352*graph_x) * PHI * 4.3774)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.3839 + 0.6161 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.3352*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Anomalous Sine Core": "# Random full-graph Instrument Script \u00b7 Anomalous Sine Core\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    field = sin((graph_x + graph_y) * 2.9777 + t) * cos((graph_z - graph_x) * 2.1127 - t)\n    wave = field * (0.5 + 0.5 * graph_energy) + domain_value * 0.1655\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1655*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Binaural Drone Generator": "# Random full-graph Instrument Script \u00b7 Binaural Drone Generator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 0.5024 + t * MEUM)\n    angular = sin(graph_angle * 3.007 + graph_phase)\n    wave = 0.5979 * radial + 0.4021 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1388*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Bit-Crushed Impulse": "# Random full-graph Instrument Script \u00b7 Bit-Crushed Impulse\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    uvw = (graph_u - graph_v + graph_w) * 5.1185\n    wave = isn(uvw + graph_phase) * 0.729 + ics(t * 0.7758) * 0.271\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2658*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Chaotic Attractor Node": "# Random full-graph Instrument Script \u00b7 Chaotic Attractor Node\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    field = sin((graph_x + graph_y) * 5.9523 + t) * cos((graph_z - graph_x) * 2.6958 - t)\n    wave = field * (0.5 + 0.5 * graph_energy) + domain_value * 0.0975\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0975*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Complex FM Modulator": "# Random full-graph Instrument Script \u00b7 Complex FM Modulator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    uvw = (graph_u - graph_v + graph_w) * 0.6333\n    wave = isn(uvw + graph_phase) * 0.7389 + ics(t * 0.8345) * 0.2611\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2122*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Complex Waveguide": "# Random full-graph Instrument Script \u00b7 Complex Waveguide\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.1059*graph_z) * MEUM * 3.2568) * cos((y - 0.1059*graph_x) * PHI * 0.5457)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.3757 + 0.6243 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1059*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Eddy Current Oscillator": "# Random full-graph Instrument Script \u00b7 Eddy Current Oscillator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 2.0983 + t * MEUM)\n    angular = sin(graph_angle * 4.5328 + graph_phase)\n    wave = 0.6109 * radial + 0.3891 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2769*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Electrostatic Discharge": "# Random full-graph Instrument Script \u00b7 Electrostatic Discharge\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.2584*graph_z) * MEUM * 4.7444) * cos((y - 0.2584*graph_x) * PHI * 0.6856)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.6566 + 0.3434 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2584*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Formant Sweep Matrix": "# Random full-graph Instrument Script \u00b7 Formant Sweep Matrix\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 4.9215 + t * MEUM)\n    angular = sin(graph_angle * 2.3895 + graph_phase)\n    wave = 0.4609 * radial + 0.5391 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1076*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Formant Vocalizer": "# Random full-graph Instrument Script \u00b7 Formant Vocalizer\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    field = sin((graph_x + graph_y) * 3.3772 + t) * cos((graph_z - graph_x) * 3.7941 - t)\n    wave = field * (0.5 + 0.5 * graph_energy) + domain_value * 0.0926\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0926*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Frequency Divider Array": "# Random full-graph Instrument Script \u00b7 Frequency Divider Array\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 3.1489 + t * MEUM)\n    angular = sin(graph_angle * 3.6655 + graph_phase)\n    wave = 0.3928 * radial + 0.6072 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.177*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Galactic Cosmic Ray": "# Random full-graph Instrument Script \u00b7 Galactic Cosmic Ray\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.1248*graph_z) * MEUM * 2.7442) * cos((y - 0.1248*graph_x) * PHI * 4.096)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.3969 + 0.6031 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1248*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Glass Resonance": "# Random full-graph Instrument Script \u00b7 Glass Resonance\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.1199*graph_z) * MEUM * 2.2904) * cos((y - 0.1199*graph_x) * PHI * 1.8298)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.7889 + 0.2111 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1199*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Granular Cloud Emitter": "# Random full-graph Instrument Script \u00b7 Granular Cloud Emitter\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 3.8039 + t * MEUM)\n    angular = sin(graph_angle * 3.2978 + graph_phase)\n    wave = 0.5441 * radial + 0.4559 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1532*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Harmonic Overdrive": "# Random full-graph Instrument Script \u00b7 Harmonic Overdrive\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    uvw = (graph_u - graph_v + graph_w) * 1.2827\n    wave = isn(uvw + graph_phase) * 0.3539 + ics(t * 3.3795) * 0.6461\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0554*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Harmonic Phase-Shift": "# Random full-graph Instrument Script \u00b7 Harmonic Phase-Shift\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.0694*graph_z) * MEUM * 2.6011) * cos((y - 0.0694*graph_x) * PHI * 3.0625)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.5121 + 0.4879 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0694*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Hyperbolic Sawtooth": "# Random full-graph Instrument Script \u00b7 Hyperbolic Sawtooth\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    field = sin((graph_x + graph_y) * 0.6874 + t) * cos((graph_z - graph_x) * 1.1611 - t)\n    wave = field * (0.5 + 0.5 * graph_energy) + domain_value * 0.1107\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1107*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
    "Magnetic Flux Modulator": "# Random full-graph Instrument Script \u00b7 Magnetic Flux Modulator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 5.177 + t * MEUM)\n    angular = sin(graph_angle * 3.9974 + graph_phase)\n    wave = 0.4588 * radial + 0.5412 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.3252*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
