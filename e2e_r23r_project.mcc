            "patch": [],
            "script": "# Random full-graph Instrument Script \u00b7 Resonant Cavity Feedback\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 5.3456 + t * MEUM)\n    angular = sin(graph_angle * 0.6119 + graph_phase)\n    wave = 0.7202 * radial + 0.2798 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.299*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
            "synth": {
