          "script": "# Random full-graph Instrument Script \u00b7 Quantum Soliton\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 4.0057 + t * MEUM)\n    angular = sin(graph_angle * 1.2816 + graph_phase)\n    wave = 0.4721 * radial + 0.5279 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.2912*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
