                "global_geometric_algo": "# Global geometric algo\ndef global_script(t, name, i, graph=None):\n    return {'scalar': isn(graph_radius * 4.482 + graph_angle * 3.853) * MEUM_NORM}\n",
                "global_geometric_algo_mix": 0.319086,
                "global_mod_algo": "# Global mod algo\ndef global_script(t, name, i, graph=None):\n    return {'scalar': sin(t * PHI * 3.853) * (graph_energy - graph_curvature)}\n",
                "global_mod_algo_mix": 0.221432,
                "global_script_algo": "# Global graph script algo\ndef global_script(t, name, i, graph=None):\n    xyz = graph_vector\n    field = MEUM_NORM * sin(xyz[0] * 4.482 + t) + (1-MEUM_NORM) * cos(xyz[1] * 3.853 - t)\n    return {'wave': field, 'x': xyz[0], 'y': xyz[1], 'z': xyz[2], 'opacity': 0.5 + 0.5*graph_energy}\n",
                "global_sequencer_algo": "# Global sequencer algo\ndef global_script(t, name, i, graph=None):\n    return {'scalar': cos(graph_phase * PHI * 3.853 + i) * MEUM_NORM}\n",
                "global_sequencer_algo_mix": 0.157366,
                "global_synth_algo": "# Global synth algo\ndef global_script(t, name, i, graph=None):\n    return {'scalar': sin(graph_phase * MEUM * 4.482) * cos(t * PHI * 3.853)}\n",
