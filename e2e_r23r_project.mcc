              "patch": [],
              "script": "# Random full-graph Instrument Script \u00b7 Percolating Noise Burst\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    spatial = sin((x + 0.1855*graph_z) * MEUM * 4.8721) * cos((y - 0.1855*graph_x) * PHI * 3.6878)\n    temporal = isn(graph_phase + t_norm * tau)\n    wave = spatial * (0.4571 + 0.5429 * temporal)\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.1855*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
              "synth": {
