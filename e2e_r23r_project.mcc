            "patch": [],
            "script": "# Random full-graph Instrument Script \u00b7 Z-Pinch Resonator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    radial = ics(graph_radius * 2.5602 + t * MEUM)\n    angular = sin(graph_angle * 2.6113 + graph_phase)\n    wave = 0.4373 * radial + 0.5627 * angular\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0578*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
            "synth": {
              "amplitude": 0.8764957119140977,
              "chaos": 0.9015917424699036,
