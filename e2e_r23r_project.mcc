              "patch": [],
              "script": "# Random full-graph Instrument Script \u00b7 Phase Distortion Core\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    uvw = (graph_u - graph_v + graph_w) * 4.7061\n    wave = isn(uvw + graph_phase) * 0.5641 + ics(t * 4.4995) * 0.4359\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0816*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
