              "patch": [],
              "script": "# Random full-graph Instrument Script \u00b7 Vector Morph Oscillator\n# Inputs: t,t_norm,x,y,z,seed,seed_w,graph_*,domain_value\ndef evaluate_wave(x, y, z, t=0.0, t_norm=0.0, graph=None):\n    field = sin((graph_x + graph_y) * 1.1483 + t) * cos((graph_z - graph_x) * 0.5492 - t)\n    wave = field * (0.5 + 0.5 * graph_energy) + domain_value * 0.0698\n    return {'wave': wave, 'amp': 0.55 + 0.45*graph_u, 'pitch': 1.0 + 0.0698*graph_curvature, 'pan': 2.0*graph_v-1.0, 'opacity': 0.5+0.5*graph_energy, 'scale': 0.75+0.5*graph_w}",
              "synth": {
